# Render environment variables (set in Render Dashboard; do not commit secrets)
DB_URL=jdbc:mysql://YOUR-MYSQL-HOST:3306/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=SET_A_NEW_DATABASE_PASSWORD
APP_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app
APP_PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Optional. If enabled, the frontend must send the same key; browser keys are visible to users.
# APP_API_KEY=
UPLOAD_DIR=/var/data/uploads
# Optional email configuration
MAIL_USERNAME=
MAIL_PASSWORD=
JPA_DDL_AUTO=update
