# Set these as environment variables in Render. Keep the existing DB values.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_EXISTING_DB_HOST:3306/offerletter_db?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=YOUR_EXISTING_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_EXISTING_DB_PASSWORD
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-new-16-character-google-app-password
APP_ALLOWED_ORIGINS=https://offerletter-frontend.vercel.app,http://localhost:5173
APP_PUBLIC_BASE_URL=https://offerletter-backend-yh42.onrender.com
UPLOAD_DIR=uploads
JPA_DDL_AUTO=update
