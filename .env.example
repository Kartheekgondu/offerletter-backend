# Set these in Render Environment (never commit real secrets)
DB_URL=jdbc:mysql://YOUR-MYSQL-HOST:3306/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=
APP_ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
APP_PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
APP_API_KEY=
UPLOAD_DIR=/var/data/uploads
JPA_DDL_AUTO=update
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
