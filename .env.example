# Local / Render backend environment examples (replace with real provider values)
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# Frontend origin (scheme + hostname only)
APP_ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app

# Public Render URL and persistent PDF storage
APP_PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
UPLOAD_DIR=/var/data/uploads

# Optional SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS
MAIL_PASSWORD=YOUR_NEW_GMAIL_APP_PASSWORD

# Optional; leave blank unless API-key protection is intentionally enabled
APP_API_KEY=
JPA_DDL_AUTO=update
