# Render -> Environment
# Replace every placeholder with values from your own managed services.
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Exact production frontend origin; no trailing slash.
APP_ALLOWED_ORIGINS=https://offerletter-frontend.vercel.app
APP_PUBLIC_BASE_URL=https://offerletter-backend-316h.onrender.com

# Configure a persistent disk mounted at /var/data if saved PDFs must survive restarts.
UPLOAD_DIR=/var/data/uploads
JPA_DDL_AUTO=update

# Optional SMTP credentials. Keep secrets only in Render Environment, never Git.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional shared API key. If set here, set the identical value as VITE_API_KEY in Vercel.
APP_API_KEY=
