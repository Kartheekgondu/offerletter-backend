# Set these in Render Dashboard > Environment. Never commit real credentials.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_DB_HOST:3306/offerletter_db?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=YOUR_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-google-workspace-or-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-google-workspace-or-gmail-address@gmail.com
APP_ALLOWED_ORIGINS=https://offerletter-frontend.vercel.app,http://localhost:5173
APP_PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
APP_API_KEY=
UPLOAD_DIR=uploads
JPA_DDL_AUTO=update
