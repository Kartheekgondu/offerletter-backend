# Render -> Web Service -> Environment
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
APP_ALLOWED_ORIGINS=https://offerletter-frontend.vercel.app
APP_PUBLIC_BASE_URL=https://offerletter-backend-o6jw.onrender.com
UPLOAD_DIR=/var/data/uploads
JPA_DDL_AUTO=update

# Gmail SMTP sender account (use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-company-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

APP_API_KEY=
